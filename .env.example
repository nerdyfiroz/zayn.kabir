PORT=3000
HOST=0.0.0.0

# Database Configuration (MongoDB Atlas or Vercel Storage)
# The database connection string (supported: MONGODB_URI, MONGO_URL, MONGODB_URL, DATABASE_URL)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Custom Database Name (Optional)
# If your URI already contains the db name (e.g. cluster0.mongodb.net/YOUR_DB_NAME?...) it is used automatically.
# Otherwise, set your custom database name here (supported: MONGODB_DB, MONGODB_DATABASE, MONGO_DB, DB_NAME, DATABASE_NAME).
MONGODB_DB=zayn_portfolio

# Collection Name (Optional, defaults to project_requests)
MONGODB_COLLECTION=project_requests

# Telegram Notification Bot Configuration
# Create a bot via @BotFather on Telegram to obtain TELEGRAM_BOT_TOKEN
# (supported: TELEGRAM_BOT_TOKEN, TELEGRAM_TOKEN, BOT_TOKEN)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram numeric chat ID or username (e.g., your numeric ID from @userinfobot or @zaynkabirweb3)
# (supported: TELEGRAM_CHAT_ID, CHAT_ID, TELEGRAM_TO)
TELEGRAM_CHAT_ID=@zaynkabirweb3
